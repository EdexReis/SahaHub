# Bu dosyayi .env olarak kopyalayin ve degerleri degistirin. .env repoya eklenmez.
DB_NAME=sahahub
DB_USER=sahahub
DB_PASSWORD=yerel-gelistirme-parolasi-degistirin
DB_PORT=5433
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# Odeme SIMULASYONU webhook imza anahtari (gercek odeme yoktur)
PAYMENT_SIM_WEBHOOK_SECRET=degistirin-uzun-rastgele-bir-deger

# Uygulamanin okudugu degiskenler (Eclipse Run Configuration > Environment sekmesine de girilebilir)
DB_URL=jdbc:postgresql://localhost:5433/sahahub
SPRING_PROFILES_ACTIVE=dev
